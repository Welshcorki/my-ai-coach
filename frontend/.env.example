# Supabase 연동 (프론트엔드 전용 — 브라우저에 노출되는 공개 키만 사용)
# 백엔드 키(GOOGLE_API_KEY, SUPABASE_JWT_SECRET, DATABASE_URL 등)는 루트의 .env 참고
# Supabase 대시보드 > Project Settings > API 에서 확인
VITE_SUPABASE_URL=https://<Reference-ID>.supabase.co
# anon public 또는 Publishable key (sb_publishable_...). secret/service_role 키 금지
VITE_SUPABASE_ANON_KEY=

# (선택) API 베이스 경로 오버라이드. 미설정 시 '/api/v2' 사용
# VITE_API_BASE_URL=
