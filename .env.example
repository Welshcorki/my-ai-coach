# ============================================
#  백엔드(.env) 환경변수 예시 — 루트에 위치
#  실제 값은 .env 에 채우세요 (.env 는 gitignore됨)
#  프론트엔드(VITE_*) 키는 frontend/.env 에 별도 작성
# ============================================

# --- AI (필수) ---
# Google AI Studio에서 발급: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --- Supabase ---
# Project Settings > API 에서 확인
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용 관리자 키 (절대 프론트엔드에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=
# JWT 검증용 비밀 (Project Settings > API > JWT Settings, HS256)
SUPABASE_JWT_SECRET=

# --- Database ---
# 미설정 시 로컬 SQLite(./app.db)로 폴백
# Supabase 예: postgresql://postgres:[PW]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=

# --- Admin ---
# 관리자 권한을 줄 이메일 (쉼표로 구분)
ADMIN_EMAILS=

# --- Dev ---
# true 로 두면 JWT 인증을 우회(로컬 프론트 테스트용). 운영에서는 반드시 false
DEV_BYPASS_AUTH=false

# --- CORS (선택) ---
# 콤마로 구분된 허용 출처. 미설정 시 로컬 개발 출처만 허용.
# 운영은 동일 출처 서빙이라 보통 불필요. 전체 허용은 * (쿠키 미사용).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Server (선택) ---
# PORT=8000
# RELOAD=true
